{
  "name": "@hotel/desktop",
  "productName": "PixalBotics Restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "PixalBotics Restaurant desktop app — finds the restaurant server on the LAN automatically",
  "author": "PixalBotics",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pixalbotics.hotelsystem",
    "productName": "PixalBotics Restaurant",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "../../releases/desktop"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PixalBoticsRestaurant-Desktop-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixalBotics Restaurant"
    }
  }
}
