generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  KG
  G
  L
  ML
  PCS
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum StockMoveType {
  IN
  OUT
  ADJUST
  SALE
}

enum PrinterKind {
  WINDOWS
  NETWORK
  FILE
}

enum PrintJobType {
  KOT
  BILL
  TEST
}

enum PrintJobStatus {
  PENDING
  PRINTING
  DONE
  FAILED
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RestaurantTable {
  id        String   @id @default(cuid())
  name      String   @unique
  area      String?
  seats     Int      @default(4)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Printer {
  id         String     @id @default(cuid())
  name       String
  kind       PrinterKind
  /// Windows printer name, "ip:port" for NETWORK, or folder for FILE
  target     String
  paperWidth Int        @default(80)
  printsKot  Boolean    @default(true)
  printsBill Boolean    @default(false)
  /// Comma separated menu categories for KOT routing; empty = all
  categories String     @default("")
  active     Boolean    @default(true)
  jobs       PrintJob[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model PrintJob {
  id            String         @id @default(cuid())
  type          PrintJobType
  status        PrintJobStatus @default(PENDING)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  payload       Json
  attempts      Int            @default(0)
  lastError     String?
  requestedById String?
  createdAt     DateTime       @default(now())
  printedAt     DateTime?
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  pinHash      String?
  active       Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  orders       Order[]  @relation("OrderCashier")
  waiterOrders Order[]  @relation("OrderWaiter")
  itemsAdded   OrderItem[] @relation("OrderItemAddedBy")
  paymentsCollected Payment[] @relation("PaymentCollectedBy")
  cashReceived      Payment[] @relation("PaymentHandedTo")
  tipShares         TipShare[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  code      String      @unique
  sortOrder Int         @default(0)
  items     StoreItem[]
}

model StoreItem {
  id             String              @id @default(cuid())
  name           String
  categoryId     String
  category       StoreCategory       @relation(fields: [categoryId], references: [id])
  unit           UnitType
  quantityOnHand Decimal             @default(0) @db.Decimal(14, 3)
  ratePerUnit    Decimal             @default(0) @db.Decimal(14, 2)
  reorderLevel   Decimal             @default(0) @db.Decimal(14, 3)
  active         Boolean             @default(true)
  ingredients    RecipeIngredient[]
  movements      StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([categoryId, name])
}

model StockMovement {
  id          String        @id @default(cuid())
  storeItemId String
  storeItem   StoreItem     @relation(fields: [storeItemId], references: [id])
  type        StockMoveType @default(IN)
  quantity    Decimal       @db.Decimal(14, 3)
  ratePerUnit Decimal?      @db.Decimal(14, 2)
  note        String?
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

model RecipeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Recipe {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String             @default("General")
  baseUnit    UnitType           @default(KG)
  baseQty     Decimal            @default(1) @db.Decimal(14, 3)
  notes       String?
  active      Boolean            @default(true)
  ingredients RecipeIngredient[]
  menuItems   MenuItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecipeIngredient {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  unit        UnitType

  @@unique([recipeId, storeItemId])
}

model MenuItem {
  id           String      @id @default(cuid())
  name         String
  category     String?
  sellUnit     UnitType
  sellingPrice Decimal     @db.Decimal(14, 2)
  recipeId     String?
  recipe       Recipe?     @relation(fields: [recipeId], references: [id])
  active       Boolean     @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Order {
  id            String          @id @default(cuid())
  orderNo       Int             @default(autoincrement())
  tableNo       String?
  status        OrderStatus     @default(PENDING)
  paymentStatus PaymentStatus   @default(UNPAID)
  notes         String?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal         @default(0) @db.Decimal(14, 2)
  /// Guest tip — tracked separately from food sale (total).
  tipAmount     Decimal         @default(0) @db.Decimal(14, 2)
  costTotal     Decimal         @default(0) @db.Decimal(14, 2)
  cashierId     String?
  cashier       User?           @relation("OrderCashier", fields: [cashierId], references: [id])
  /// Who took / placed the order (waiter, manager, or cashier).
  waiterId      String?
  waiter        User?           @relation("OrderWaiter", fields: [waiterId], references: [id])
  /// Free-text name of who served the table (not a system user).
  servedByName  String?
  kotRounds     Int             @default(1)
  billRequestedAt DateTime?
  items         OrderItem[]
  stockMoves    StockMovement[]
  printJobs     PrintJob[]
  payments      Payment[]
  tipShares     TipShare[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// One payment taken for an order. Staff without a cash drawer (managers) hand the cash
/// to a cashier: handedTo is that cashier, who confirms when the money is received.
model Payment {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(14, 2)
  /// Tip collected with this payment (not part of order.total / amount).
  tipAmount     Decimal   @default(0) @db.Decimal(14, 2)
  collectedById String
  collectedBy   User      @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  handedToId    String?
  handedTo      User?     @relation("PaymentHandedTo", fields: [handedToId], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([handedToId, confirmedAt])
}

/// Tip allocated to a staff member for an order (split by restaurant tip policy).
model TipShare {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  /// ORDER_TAKER | SERVER | POOL
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem  @relation(fields: [menuItemId], references: [id])
  name            String
  sellUnit        UnitType
  quantity        Decimal   @db.Decimal(14, 3)
  ratePerUnit     Decimal   @db.Decimal(14, 2)
  amount          Decimal   @db.Decimal(14, 2)
  unitCost        Decimal   @default(0) @db.Decimal(14, 2)
  costAmount      Decimal   @default(0) @db.Decimal(14, 2)
  notes           String?
  kotRound        Int       @default(1)
  addedById       String?
  addedBy         User?     @relation("OrderItemAddedBy", fields: [addedById], references: [id])
  createdAt       DateTime  @default(now())
}
