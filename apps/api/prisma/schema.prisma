generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  KG
  G
  L
  ML
  PCS
}

/// Grocery purchase packaging (1 tray / box / carton … → stock units).
enum PackUnit {
  NONE
  BOX
  PACKET
  TRAY
  CRATE
  CARTON
  DOZEN
  BUNDLE
  SACK
  TIN
  BAG
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  /// Kitchen bumped / food out — not the same as billing COMPLETED.
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  /// Cancelled order — never unpaid / payable / open-table.
  VOID
}

enum StockMoveType {
  IN
  OUT
  ADJUST
  SALE
  /// Morning special cook (recipe OUT) — not plate sales.
  COOK
  /// Order cancel / qty-down put-back (offsets SALE for net usage).
  RESTORE
  /// Main store → kitchen issue (daily transfer).
  KITCHEN_TRANSFER
  /// Kitchen → store return.
  KITCHEN_RETURN
  /// Kitchen closing extra / wastage (kitchen balance only).
  KITCHEN_OUT
}

/// How the guest paid (offline label — no card gateway).
enum PaymentMethod {
  CASH
  CARD
  WALLET
  BANK
}


/// Who covered travel / loading / other costs on a purchase.
enum ExtraExpensePaidBy {
  SUPPLIER
  SELF
}

/// Purchase paid now (cash) or later (credit).
enum PurchasePayKind {
  CASH
  CREDIT
}

/// Hotel / ops expense sheet (salary, utilities, etc.) — separate from store purchases.
enum HotelExpensePeriod {
  DAILY
  MONTHLY
}

/// How a worker is normally paid (rate interpretation).
enum WorkerPayType {
  DAILY
  MONTHLY
}

/// Worker advance / opening ledger (lena = advance, dena = payable).
enum WorkerLedgerKind {
  /// Data-shift: opening بنام (worker owes hotel) — Debit.
  OPENING_ADVANCE
  /// Data-shift: opening جمع (hotel owes worker) — Credit.
  OPENING_PAYABLE
  /// Net cash / advance paid out (Debit, hotel expense).
  ADVANCE
  /// Monthly salary jama — Credit (no cash yet).
  SALARY_CREDIT
  /// Other debit (khana bill, etc.) — Debit, hotel expense.
  OTHER_DEBIT
  /// Legacy: advance cut from a salary payment — treated as Credit.
  RECOVERY
  /// Legacy: old payable cleared with cash — treated as Debit.
  SETTLE_PAYABLE
}

/// Cash drawer counters on the daily restaurant close report.
enum CashCounterKind {
  COUNTER_1
  COUNTER_2
}

enum PrinterKind {
  WINDOWS
  NETWORK
  FILE
  /// USB / Windows printer on an Additional PC (desktop print agent)
  AGENT
}

enum PrintJobType {
  KOT
  BILL
  BILL_EDIT
  TEST
  /// A4 / office PDF reports (close, audit, kitchen, supplier) via Other print printers
  REPORT
}

enum PrintJobStatus {
  PENDING
  PRINTING
  DONE
  FAILED
}

/// MENU = normal dish; PER_HEAD = cover charge (settings-priced, no kitchen print).
enum OrderLineKind {
  MENU
  PER_HEAD
}

/// NORMAL = store recipe on sale; SPECIAL = daily cooked pot; MIX = deal (multi store ± pot).
enum MenuItemKind {
  NORMAL
  SPECIAL
  MIX
}

/// One line inside a MIX deal: store recipe or optional cooked pot.
enum MenuDealPartKind {
  STORE
  SPECIAL
}

enum DailyBatchStatus {
  OPEN
  CLOSED
}

/// How a special line was sold on the order.
enum SpecialSaleMode {
  PLATE
  RS
  MIX
  MIX_SOLO_STORE
}

/// Which sell paths Waiter may use for this pot.
enum SpecialSellMode {
  BOTH
  SERVING_ONLY
  RS_ONLY
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Floor area / section (Hall, Lawn, …). Tables are unique within a partition.
model TablePartition {
  id        String            @id @default(cuid())
  name      String            @unique
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
}

model RestaurantTable {
  id          String         @id @default(cuid())
  name        String
  /// Legacy free-text area (kept for display); prefer partition.
  area        String?
  partitionId String
  partition   TablePartition @relation(fields: [partitionId], references: [id])
  seats       Int            @default(4)
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  orders      Order[]
  createdAt   DateTime       @default(now())

  @@unique([partitionId, name])
}

/// Desktop app on an Additional PC that owns local USB printers.
model PrintAgent {
  id          String    @id @default(cuid())
  /// Stable id generated once on that PC (stored in desktop config).
  machineKey  String    @unique
  hostname    String
  displayName String    @default("")
  /// Bearer token for claim / heartbeat (rotated on register if missing).
  token       String    @unique
  lastSeenAt  DateTime  @default(now())
  /// Last USB / PnP device snapshot from that PC (incl. Unknown USB) — diagnosis only.
  devices     Json      @default("[]")
  printers    Printer[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Printer {
  id         String      @id @default(cuid())
  name       String
  kind       PrinterKind
  /// Windows printer name, "ip:port" for NETWORK, folder for FILE, or Windows name on agent PC for AGENT
  target     String
  paperWidth Int         @default(80)
  printsKot  Boolean     @default(true)
  printsBill Boolean     @default(false)
  /// A4 / office PDFs (close, audit, kitchen, supplier) — server Windows printers
  printsOther Boolean    @default(false)
  /// Counter / station label e.g. "Cashier 1" (industrial multi-counter)
  station    String      @default("")
  /// Comma separated menu categories for KOT routing; empty = all
  categories String      @default("")
  active     Boolean     @default(true)
  /// Set when kind=AGENT — which Additional PC owns this USB printer
  agentId    String?
  agent      PrintAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobs       PrintJob[]
  cashiers   User[]      @relation("UserBillPrinter")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([agentId, target])
}

model PrintJob {
  id            String         @id @default(cuid())
  type          PrintJobType
  status        PrintJobStatus @default(PENDING)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  payload       Json
  attempts      Int            @default(0)
  lastError     String?
  requestedById String?
  createdAt     DateTime       @default(now())
  printedAt     DateTime?
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  passwordHash  String
  pinHash       String?
  active        Boolean  @default(true)
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  /// Default bill printer for this cashier (industrial: each counter → own network printer)
  billPrinterId String?
  billPrinter   Printer? @relation("UserBillPrinter", fields: [billPrinterId], references: [id], onDelete: SetNull)
  orders            Order[]     @relation("OrderCashier")
  waiterOrders      Order[]     @relation("OrderWaiter")
  assignedOrders    Order[]     @relation("OrderAssignedCashier")
  cancelledOrders   Order[]     @relation("OrderCancelledBy")
  billEdits         OrderBillEdit[] @relation("OrderBillEditedBy")
  billEditConfirms  OrderBillEdit[] @relation("OrderBillEditConfirmedBy")
  itemsAdded        OrderItem[] @relation("OrderItemAddedBy")
  paymentsCollected Payment[]   @relation("PaymentCollectedBy")
  cashReceived      Payment[]   @relation("PaymentHandedTo")
  tipShares         TipShare[]
  dayCloses         DayStockClose[]
  kitchenDayCloses  KitchenDayClose[]
  dayCashCloses     DayCashClose[]
  hotelExpenses     HotelExpense[]
  workerSalaryPayments WorkerSalaryPayment[]
  workerLedgerEntries  WorkerLedgerEntry[]
  /// Soft-delete: keeps bill/payment history FKs intact while removing login.
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([deletedAt])
}

model StoreCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  code      String      @unique
  sortOrder Int         @default(0)
  items     StoreItem[]
}

model StoreItem {
  id             String              @id @default(cuid())
  name           String
  categoryId     String
  category       StoreCategory       @relation(fields: [categoryId], references: [id])
  unit           UnitType
  /// How the item is bought (tray, box…). NONE = buy in stock unit only.
  packUnit       PackUnit            @default(NONE)
  /// Stock units inside one pack (e.g. 30 eggs per tray). Ignored when packUnit is NONE.
  unitsPerPack   Decimal             @default(1) @db.Decimal(14, 3)
  quantityOnHand Decimal             @default(0) @db.Decimal(14, 3)
  ratePerUnit    Decimal             @default(0) @db.Decimal(14, 2)
  reorderLevel   Decimal             @default(0) @db.Decimal(14, 3)
  active         Boolean             @default(true)
  ingredients         RecipeIngredient[]
  movements           StockMovement[]
  purchaseLines       PurchaseLine[]
  dayCloseLines       DayStockCloseLine[]
  kitchenStock         KitchenStock[]
  kitchenDayCloseLines KitchenDayCloseLine[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([categoryId, name])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  /// What they supply (e.g. dairy, vegetables, packaging).
  supplyOf  String?
  brand     String?
  address   String?
  notes     String?
  active    Boolean           @default(true)
  purchases Purchase[]
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([name])
}

model Purchase {
  id          String          @id @default(cuid())
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  /// Noon-local timestamp of the business day the goods arrived.
  purchasedAt DateTime
  payKind     PurchasePayKind
  /// Amount paid to the supplier on this invoice (inventory + supplier-side extra expense).
  paidAmount  Decimal         @default(0) @db.Decimal(14, 2)
  /// Inventory lines only (does not include extra expense).
  total       Decimal         @db.Decimal(14, 2)
  /// Travel / loading / other cost on this purchase (not stock value).
  extraExpense        Decimal              @default(0) @db.Decimal(14, 2)
  extraExpenseNote    String?
  /// null when extraExpense is 0. SELF does not affect supplier balance.
  extraExpensePaidBy  ExtraExpensePaidBy?
  note        String?
  /// Relative file name under data/purchase-bills (e.g. cuid.jpg). Optional supplier invoice photo.
  billImagePath String?
  /// When set, purchase is voided — stock reversed, excluded from supplier balance.
  voidedAt    DateTime?
  voidNote    String?
  lines       PurchaseLine[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([purchasedAt])
  @@index([supplierId])
  @@index([voidedAt])
}

model PurchaseLine {
  id           String    @id @default(cuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  storeItemId  String
  storeItem    StoreItem @relation(fields: [storeItemId], references: [id])
  categoryName String
  unit         UnitType
  quantity     Decimal   @db.Decimal(14, 3)
  /// Rate on this invoice. Never rewritten when a later purchase changes the item rate.
  ratePerUnit  Decimal   @db.Decimal(14, 2)
  amount       Decimal   @db.Decimal(14, 2)
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  paidAt     DateTime
  note       String?
  /// True once this payment has been applied onto purchase.paidAmount (oldest bills first).
  allocated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([supplierId, paidAt])
}

model StockMovement {
  id             String          @id @default(cuid())
  storeItemId    String
  storeItem      StoreItem       @relation(fields: [storeItemId], references: [id])
  type           StockMoveType   @default(IN)
  quantity       Decimal         @db.Decimal(14, 3)
  ratePerUnit    Decimal?        @db.Decimal(14, 2)
  note           String?
  /// Kitchen station code for transfer / sale / cook / kitchen-out (null = store-only move).
  kitchenStation String?
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId     String?
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  dayCloseId     String?
  dayClose       DayStockClose?  @relation(fields: [dayCloseId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([kitchenStation, createdAt])
}

/// User-managed kitchen stations (KOT routing + station stock / closing).
model KitchenStationDef {
  id        String   @id @default(cuid())
  /// Stable code stored on menu / stock / movements (e.g. COOKING, BBQ, TANDOOR).
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  /// Seeded defaults — code cannot be changed; soft-deactivate only if unused.
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// One stock close per business day (day starts at the time set in Settings).
model DayStockClose {
  id             String              @id @default(cuid())
  businessDate   String              @unique
  stockUsedValue Decimal             @db.Decimal(14, 2)
  sales          Decimal             @default(0) @db.Decimal(14, 2)
  profit         Decimal             @default(0) @db.Decimal(14, 2)
  closedById     String?
  closedBy       User?               @relation(fields: [closedById], references: [id], onDelete: SetNull)
  editedAt       DateTime?
  editedById     String?
  editedByName   String?
  editReason     String?
  lines          DayStockCloseLine[]
  movements      StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model DayStockCloseLine {
  id          String        @id @default(cuid())
  closeId     String
  close       DayStockClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem     @relation(fields: [storeItemId], references: [id])
  /// Legacy field — store closing now uses transferredQty for kitchen issues.
  autoQty     Decimal       @db.Decimal(14, 3)
  /// Qty issued to kitchen today (from KITCHEN_TRANSFER movements).
  transferredQty Decimal    @default(0) @db.Decimal(14, 3)
  /// Manual store-side used (separate from Extra).
  usedQty     Decimal       @default(0) @db.Decimal(14, 3)
  /// Extra used at store (wastage, staff meal, etc.).
  extraQty    Decimal       @default(0) @db.Decimal(14, 3)
  /// Physical count left in store at closing.
  leftoverQty Decimal       @default(0) @db.Decimal(14, 3)
  reason      String?
  ratePerUnit Decimal       @db.Decimal(14, 2)
  amount      Decimal       @db.Decimal(14, 2)

  @@unique([closeId, storeItemId])
}

/// Qty sitting at a kitchen station after store → station transfers (recipe sales deduct here).
model KitchenStock {
  id             String   @id @default(cuid())
  storeItemId    String
  storeItem      StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  /// KitchenStationDef.code
  station        String   @default("COOKING")
  quantityOnHand Decimal  @default(0) @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeItemId, station])
  @@index([station])
}

/// Kitchen daily closing per station — recipe use vs transfers (separate from store closing).
model KitchenDayClose {
  id                 String                @id @default(cuid())
  businessDate       String
  /// KitchenStationDef.code
  station            String                @default("COOKING")
  stockUsedValue     Decimal               @db.Decimal(14, 2)
  transferredValue   Decimal               @default(0) @db.Decimal(14, 2)
  sales              Decimal               @default(0) @db.Decimal(14, 2)
  profit             Decimal               @default(0) @db.Decimal(14, 2)
  closedById         String?
  closedBy           User?                 @relation(fields: [closedById], references: [id], onDelete: SetNull)
  editedAt           DateTime?
  editedById         String?
  editedByName       String?
  editReason         String?
  lines              KitchenDayCloseLine[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([businessDate, station])
}

model KitchenDayCloseLine {
  id              String          @id @default(cuid())
  closeId         String
  close           KitchenDayClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  storeItemId     String
  storeItem       StoreItem       @relation(fields: [storeItemId], references: [id])
  kitchenOnHand   Decimal         @db.Decimal(14, 3)
  transferredQty  Decimal         @default(0) @db.Decimal(14, 3)
  /// Recipe / bill auto use for the day.
  autoQty         Decimal         @default(0) @db.Decimal(14, 3)
  /// Declared used (defaults to autoQty; editable for manual closing).
  usedQty         Decimal         @default(0) @db.Decimal(14, 3)
  /// Extra used (wastage, staff meal, etc.).
  extraQty        Decimal         @default(0) @db.Decimal(14, 3)
  reason          String?
  ratePerUnit     Decimal         @db.Decimal(14, 2)
  amount          Decimal         @db.Decimal(14, 2)

  @@unique([closeId, storeItemId])
}

model RecipeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Recipe {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String             @default("General")
  baseUnit    UnitType           @default(KG)
  baseQty     Decimal            @default(1) @db.Decimal(14, 3)
  /// Target kitchen prep time for linked menu items (minutes).
  prepMinutes Int                @default(15)
  notes       String?
  active      Boolean            @default(true)
  ingredients RecipeIngredient[]
  menuItems   MenuItem[]
  dealParts   MenuDealPart[]
  specialCook SpecialProduct[]   @relation("SpecialCookRecipe")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecipeIngredient {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  unit        UnitType

  @@unique([recipeId, storeItemId])
}

model MenuItem {
  id             String         @id @default(cuid())
  name           String
  category       String?
  /// Kitchen printer station (Beverages / Cooking / BBQ).
  /// KitchenStationDef.code — KOT + station stock.
  kitchenStation String @default("COOKING")
  kind           MenuItemKind   @default(NORMAL)
  sellUnit       UnitType
  sellingPrice   Decimal        @db.Decimal(14, 2)
  /// Qty in sellUnit the menu card price refers to (e.g. 0.5 KG = 500g half at list price).
  /// Bill still uses sellingPrice × ordered qty — order can be less or more.
  listPortionQty Decimal        @default(1) @db.Decimal(14, 3)
  /// Lowest order qty in sellUnit (e.g. 0.225 KG / 1 PCS). 0 = no floor beyond > 0.
  minQty         Decimal        @default(0) @db.Decimal(14, 3)
  /// Highest order qty; null = no cap (e.g. Half band max 1 KG).
  maxQty         Decimal?       @db.Decimal(14, 3)
  /// +/- / chip step; null = unit default (KG/L 0.5, else 1).
  qtyStep        Decimal?       @db.Decimal(14, 3)
  /// false = only min + n×step (no free decimal typing).
  allowCustomQty Boolean        @default(true)
  /// Store recipe (NORMAL / primary MIX store part). Null for pure SPECIAL.
  recipeId       String?
  recipe         Recipe?        @relation(fields: [recipeId], references: [id])
  /// Daily cooked pot (SPECIAL / primary MIX pot). Optional for store-only deals.
  specialProductId String?
  specialProduct   SpecialProduct? @relation(fields: [specialProductId], references: [id])
  /// SPECIAL half/full share, or primary MIX pot plates per 1 deal (legacy / denormalized).
  mixSpecialPlates Decimal?     @db.Decimal(14, 3)
  active         Boolean        @default(true)
  orderItems     OrderItem[]
  modifiers      MenuModifier[]
  /// MIX deal lines (multiple store recipes ± optional pots). Source of truth for MIX.
  dealParts      MenuDealPart[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

/// One part of a MIX deal: inventory recipe and/or cooked pot plates per 1 deal qty.
model MenuDealPart {
  id               String           @id @default(cuid())
  menuItemId       String
  menuItem         MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  kind             MenuDealPartKind
  recipeId         String?
  recipe           Recipe?          @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  specialProductId String?
  specialProduct   SpecialProduct?  @relation(fields: [specialProductId], references: [id], onDelete: Restrict)
  /// Per 1 deal: recipe multiplier (STORE) or pot plates (SPECIAL).
  quantity         Decimal          @default(1) @db.Decimal(14, 3)
  sortOrder        Int              @default(0)
  label            String?
  createdAt        DateTime         @default(now())

  @@index([menuItemId, sortOrder])
}

/// Optional add-on on a menu item (e.g. Extra cheese +50).
model MenuModifier {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal  @db.Decimal(14, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([menuItemId, active])
}

/// Master for a daily-cooked pot (e.g. Daal Special). Cook once → sell all day from remaining.
model SpecialProduct {
  id           String          @id @default(cuid())
  name         String          @unique
  category     String          @default("Pakistani Special")
  /// Display name for one serving: Plate, Glass, Box, Bowl, Cup…
  servingLabel String          @default("Plate")
  /// Waiter: BOTH = serving + Rs; SERVING_ONLY / RS_ONLY lock the other path.
  sellMode     SpecialSellMode @default(BOTH)
  /// Price of one full serving (plate/glass/box…).
  platePrice   Decimal         @db.Decimal(14, 2)
  /// Optional separate half-serving sell price. Null = no half plate on Waiter.
  halfPlatePrice Decimal?      @db.Decimal(14, 2)
  /// Grams (or ml≈g) in one full serving. Rs sale converts via platePrice/plateGrams.
  plateGrams   Decimal         @db.Decimal(14, 3)
  /// Recipe used when System Manager logs morning cook (store OUT once).
  cookRecipeId String?
  cookRecipe   Recipe?         @relation("SpecialCookRecipe", fields: [cookRecipeId], references: [id])
  /// KOT station for the synced SPECIAL menu row (Beverages / Cooking / BBQ).
  /// KitchenStationDef.code — KOT + station stock.
  kitchenStation String @default("COOKING")
  active       Boolean         @default(true)
  menuItems    MenuItem[]
  dealParts    MenuDealPart[]
  batches      DailyBatch[]
  closeLines   DayBatchCloseLine[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// One pot per special product per business day.
model DailyBatch {
  id                 String           @id @default(cuid())
  specialProductId   String
  specialProduct     SpecialProduct   @relation(fields: [specialProductId], references: [id], onDelete: Cascade)
  businessDate       String
  /// Carried from previous day close (grams).
  openingCarryGrams  Decimal          @default(0) @db.Decimal(14, 3)
  /// Newly cooked today (grams).
  cookedGrams        Decimal          @default(0) @db.Decimal(14, 3)
  /// Sum of ingredient cost from cook logs today (actual amounts used).
  cookCostTotal      Decimal          @default(0) @db.Decimal(14, 2)
  /// Sold via orders (grams).
  soldGrams          Decimal          @default(0) @db.Decimal(14, 3)
  /// Grams moved to the next day's opening carry (orphan / post-close cook recovery).
  carryOutGrams      Decimal          @default(0) @db.Decimal(14, 3)
  status             DailyBatchStatus @default(OPEN)
  note               String?
  cookedById         String?
  cookedByName       String?
  cookedAt           DateTime?
  closedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([specialProductId, businessDate])
  @@index([businessDate])
  @@index([status])
}

/// End-of-day disposition for all special pots (carry / waste → loss).
model DayBatchClose {
  id           String              @id @default(cuid())
  businessDate String              @unique
  note         String?
  closedById   String?
  closedByName String?
  lines        DayBatchCloseLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model DayBatchCloseLine {
  id                     String         @id @default(cuid())
  closeId                String
  close                  DayBatchClose  @relation(fields: [closeId], references: [id], onDelete: Cascade)
  specialProductId       String
  specialProduct         SpecialProduct @relation(fields: [specialProductId], references: [id])
  dailyBatchId           String?
  systemRemainingGrams   Decimal        @db.Decimal(14, 3)
  countedRemainingGrams  Decimal        @db.Decimal(14, 3)
  carryGrams             Decimal        @default(0) @db.Decimal(14, 3)
  wasteGrams             Decimal        @default(0) @db.Decimal(14, 3)
  wasteNote              String?
  /// Cost attributed to waste (from cook recipe unit cost × waste grams / plateGrams scale).
  lossCost               Decimal        @default(0) @db.Decimal(14, 2)

  @@unique([closeId, specialProductId])
}

/// Seated guest who eats now and pays the whole account later. Not supplier credit.
model CreditCustomer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  cnic      String?  @unique
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String          @id @default(cuid())
  orderNo       Int             @default(autoincrement())
  /// Display label e.g. "Hall · T-1"
  tableNo       String?
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status        OrderStatus     @default(PENDING)
  paymentStatus PaymentStatus   @default(UNPAID)
  notes         String?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  /// Discount taken off the food total (gross − discount = net food).
  discountAmount Decimal        @default(0) @db.Decimal(14, 2)
  /// Sales tax on (gross − discount). 0 when tax disabled.
  taxAmount     Decimal         @default(0) @db.Decimal(14, 2)
  /// Tax % applied when taxAmount was set (snapshot).
  taxPercent    Decimal         @default(0) @db.Decimal(8, 4)
  paidAmount    Decimal         @default(0) @db.Decimal(14, 2)
  /// Cash the guest handed over (may be more than paidAmount; change = tendered − paid − tip).
  tenderedAmount Decimal        @default(0) @db.Decimal(14, 2)
  /// Guest tip — tracked separately from food sale (total).
  tipAmount     Decimal         @default(0) @db.Decimal(14, 2)
  costTotal     Decimal         @default(0) @db.Decimal(14, 2)
  cashierId     String?
  cashier       User?           @relation("OrderCashier", fields: [cashierId], references: [id])
  /// Who took / placed the order (supervisor, waiter, or cashier).
  waiterId      String?
  waiter        User?           @relation("OrderWaiter", fields: [waiterId], references: [id])
  /// Cashier selected at place-time (Main Cashier or Cashier) for billing.
  assignedCashierId String?
  assignedCashier   User?       @relation("OrderAssignedCashier", fields: [assignedCashierId], references: [id])
  /// Free-text name of who served the table (not a system user).
  servedByName  String?
  kotRounds     Int             @default(1)
  billRequestedAt DateTime?
  /// When the ticket entered (or re-entered) PENDING — used for start-delay alerts.
  pendingAt     DateTime        @default(now())
  /// When kitchen pressed Start (PREPARING).
  preparingAt   DateTime?
  /// When kitchen marked READY.
  readyAt       DateTime?
  /// Set when the 1-minute pending alert was sent (avoid spam).
  pendingAlertedAt DateTime?
  /// Set when the first over-target prep alert was sent.
  lateAlertedAt DateTime?
  /// Why the Main Cashier cancelled (required on cancel).
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?           @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  /// Set when the meal is on a credit account. Cash is collected later, in one settlement.
  creditCustomerId String?
  creditCustomer   CreditCustomer? @relation(fields: [creditCustomerId], references: [id])
  items         OrderItem[]
  stockMoves    StockMovement[]
  printJobs     PrintJob[]
  payments      Payment[]
  tipShares     TipShare[]
  billEdits     OrderBillEdit[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([assignedCashierId])
  @@index([tableId])
  @@index([waiterId])
  @@index([creditCustomerId])
  @@index([cancelledAt])
  @@index([status, pendingAt])
  @@index([status, preparingAt])
}

/// Audit trail when Main Cashier edits a PAID bill (reason + before/after amounts).
model OrderBillEdit {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason           String
  beforeTotal      Decimal   @db.Decimal(14, 2)
  afterTotal       Decimal   @db.Decimal(14, 2)
  beforeNet        Decimal   @db.Decimal(14, 2)
  afterNet         Decimal   @db.Decimal(14, 2)
  beforePaidAmount Decimal   @db.Decimal(14, 2)
  afterPaidAmount  Decimal   @db.Decimal(14, 2)
  /// Snapshot of line changes: [{ name, beforeQty, afterQty, beforeAmount, afterAmount }]
  itemsJson        Json?
  editedById       String
  editedBy         User      @relation("OrderBillEditedBy", fields: [editedById], references: [id])
  editedByName     String
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?     @relation("OrderBillEditConfirmedBy", fields: [confirmedById], references: [id])
  confirmedByName  String?
  createdAt        DateTime  @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([confirmedAt])
}

/// One payment taken for an order. Staff without a cash drawer (managers) hand the cash
/// to a cashier: handedTo is that cashier, who confirms when the money is received.
model Payment {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(14, 2)
  /// Cash the guest gave for this payment (may exceed amount; change returned). Card/wallet often equals amount.
  tenderedAmount Decimal       @default(0) @db.Decimal(14, 2)
  /// Tip collected with this payment (not part of order.total / amount).
  tipAmount     Decimal        @default(0) @db.Decimal(14, 2)
  method        PaymentMethod  @default(CASH)
  collectedById String
  collectedBy   User           @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  handedToId    String?
  handedTo      User?          @relation("PaymentHandedTo", fields: [handedToId], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([handedToId, confirmedAt])
  @@index([method, createdAt])
}

/// Tip allocated to a staff member for an order (split by restaurant tip policy).
model TipShare {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  /// ORDER_TAKER | SERVER | POOL
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineKind        OrderLineKind @default(MENU)
  /// Null for PER_HEAD cover-charge lines.
  menuItemId      String?
  menuItem        MenuItem?     @relation(fields: [menuItemId], references: [id])
  name            String
  sellUnit        UnitType
  quantity        Decimal       @db.Decimal(14, 3)
  ratePerUnit     Decimal       @db.Decimal(14, 2)
  amount          Decimal       @db.Decimal(14, 2)
  unitCost        Decimal       @default(0) @db.Decimal(14, 2)
  costAmount      Decimal       @default(0) @db.Decimal(14, 2)
  /// Grams taken from daily special batch (SPECIAL / primary MIX pot).
  batchGrams      Decimal       @default(0) @db.Decimal(14, 3)
  specialProductId String?
  saleMode        SpecialSaleMode?
  notes           String?
  /// Selected modifiers snapshot: [{ id?, name, priceDelta }]
  modifiersJson   Json?
  /// MIX deal stock snapshot: { recipes:[{recipeId,quantity}], specials:[{specialProductId,grams}] }
  dealTakesJson   Json?
  kotRound        Int           @default(1)
  addedById       String?
  addedBy         User?         @relation("OrderItemAddedBy", fields: [addedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([orderId, lineKind])
}

/// Admin / System Manager daily cash close — counters, paid bills, pending, miss cash.
model DayCashClose {
  id             String                @id @default(cuid())
  businessDate   String                @unique
  note           String?
  expectedCash   Decimal               @db.Decimal(14, 2)
  collectedCash  Decimal               @db.Decimal(14, 2)
  missCash       Decimal               @db.Decimal(14, 2)
  pendingAmount  Decimal               @default(0) @db.Decimal(14, 2)
  pendingCount   Int                   @default(0)
  paidBillsCount Int                   @default(0)
  paidSalesTotal Decimal               @default(0) @db.Decimal(14, 2)
  /// Paid food sales for the business day (not inventory profit).
  totalSale      Decimal               @default(0) @db.Decimal(14, 2)
  closedById     String?
  closedBy       User?                 @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closedByName   String?
  /// When set, that business day's sales edits/payments are locked (admin can unlock).
  lockedAt       DateTime?
  /// Non-cash tender totals (not in drawer).
  cardTotal      Decimal               @default(0) @db.Decimal(14, 2)
  walletTotal    Decimal               @default(0) @db.Decimal(14, 2)
  bankTotal      Decimal               @default(0) @db.Decimal(14, 2)
  openingFloat   Decimal               @default(0) @db.Decimal(14, 2)
  counters       DayCashCloseCounter[]
  soldItems      DayCashCloseSoldItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model DayCashCloseCounter {
  id            String          @id @default(cuid())
  closeId       String
  close         DayCashClose    @relation(fields: [closeId], references: [id], onDelete: Cascade)
  kind          CashCounterKind
  label         String
  expectedCash  Decimal         @db.Decimal(14, 2)
  collectedCash Decimal         @db.Decimal(14, 2)
  missCash      Decimal         @db.Decimal(14, 2)
  missReason    String?
  billCount     Int             @default(0)
  paymentCount  Int             @default(0)
  tipTotal      Decimal         @default(0) @db.Decimal(14, 2)
  /// Snapshot of payment rows for this counter at close time.
  paymentsJson  Json?

  @@unique([closeId, kind])
}

model DayCashCloseSoldItem {
  id      String       @id @default(cuid())
  closeId String
  close   DayCashClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  name    String
  qty     Decimal      @db.Decimal(14, 3)
  amount  Decimal      @db.Decimal(14, 2)

  @@index([closeId])
}

/// Optional labels for the hotel expense sheet (user-created).
model HotelExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// Admin hotel expense sheet — salary, utilities, maintenance, etc.
model HotelExpense {
  id          String             @id @default(cuid())
  /// Business day the expense belongs to (noon local).
  spentAt     DateTime
  /// Optional kind (Salary, Electricity, …) — free text, not required.
  category    String?
  /// Person or detail (employee name, bill ref, …).
  title       String
  amount      Decimal            @db.Decimal(14, 2)
  period      HotelExpensePeriod @default(DAILY)
  note        String?
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Optional link from Worker Record salary payment (cascade deletes payment if expense removed).
  workerSalaryPayment WorkerSalaryPayment?
  /// Optional link from Worker advance ledger (cash advance expense).
  workerLedgerEntry   WorkerLedgerEntry?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([spentAt])
  @@index([category])
}

/// Non-login staff for salary / payroll (cleaners, helpers, etc.).
model Worker {
  id        String       @id @default(cuid())
  name      String
  jobTitle  String?
  phone     String?
  payType   WorkerPayType @default(MONTHLY)
  /// Expected daily or monthly rate (hint when paying; payment amount can differ).
  rate      Decimal      @default(0) @db.Decimal(14, 2)
  active    Boolean      @default(true)
  note      String?
  deletedAt DateTime?
  payments  WorkerSalaryPayment[]
  ledger    WorkerLedgerEntry[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([active])
  @@index([deletedAt])
  @@index([name])
}

/// One salary payout — also creates a HotelExpense (category Salary) for cash portion.
model WorkerSalaryPayment {
  id               String             @id @default(cuid())
  workerId         String
  worker           Worker             @relation(fields: [workerId], references: [id], onDelete: Restrict)
  /// Business day the salary belongs to (noon local).
  paidOn           DateTime
  /// Gross salary for this payment (cash + advance recovery).
  amount           Decimal            @db.Decimal(14, 2)
  /// Cut from remaining advance (not cash out).
  advanceRecovered Decimal            @default(0) @db.Decimal(14, 2)
  /// Cleared from opening payable / dena (adds to cash out).
  payableSettled   Decimal            @default(0) @db.Decimal(14, 2)
  period           HotelExpensePeriod @default(DAILY)
  note             String?
  hotelExpenseId   String?            @unique
  hotelExpense     HotelExpense?      @relation(fields: [hotelExpenseId], references: [id], onDelete: Cascade)
  ledgerEntries    WorkerLedgerEntry[]
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([paidOn])
  @@index([workerId, paidOn])
}

/// Opening balances, advances given, recoveries, payable settlements.
model WorkerLedgerEntry {
  id              String           @id @default(cuid())
  workerId        String
  worker          Worker           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  kind            WorkerLedgerKind
  amount          Decimal          @db.Decimal(14, 2)
  /// Business day (noon local).
  entryOn         DateTime
  note            String?
  hotelExpenseId  String?          @unique
  hotelExpense    HotelExpense?    @relation(fields: [hotelExpenseId], references: [id], onDelete: Cascade)
  salaryPaymentId String?
  salaryPayment   WorkerSalaryPayment? @relation(fields: [salaryPaymentId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workerId, kind])
  @@index([entryOn])
  @@index([salaryPaymentId])
}
