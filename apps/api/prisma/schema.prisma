generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  KG
  G
  L
  ML
  PCS
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum StockMoveType {
  IN
  OUT
  ADJUST
  SALE
}

/// Cash = paid with the invoice. Credit = some or all still outstanding.
enum PurchasePayKind {
  CASH
  CREDIT
}

enum PrinterKind {
  WINDOWS
  NETWORK
  FILE
}

enum PrintJobType {
  KOT
  BILL
  TEST
}

enum PrintJobStatus {
  PENDING
  PRINTING
  DONE
  FAILED
}

/// Kitchen routing station — maps to KOT printers (Beverages / Cooking / BBQ).
enum KitchenStation {
  BEVERAGES
  COOKING
  BBQ
}

/// MENU = normal dish; PER_HEAD = cover charge (settings-priced, no kitchen print).
enum OrderLineKind {
  MENU
  PER_HEAD
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Floor area / section (Hall, Lawn, …). Tables are unique within a partition.
model TablePartition {
  id        String            @id @default(cuid())
  name      String            @unique
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
}

model RestaurantTable {
  id          String         @id @default(cuid())
  name        String
  /// Legacy free-text area (kept for display); prefer partition.
  area        String?
  partitionId String
  partition   TablePartition @relation(fields: [partitionId], references: [id])
  seats       Int            @default(4)
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  orders      Order[]
  createdAt   DateTime       @default(now())

  @@unique([partitionId, name])
}

model Printer {
  id         String     @id @default(cuid())
  name       String
  kind       PrinterKind
  /// Windows printer name, "ip:port" for NETWORK, or folder for FILE
  target     String
  paperWidth Int        @default(80)
  printsKot  Boolean    @default(true)
  printsBill Boolean    @default(false)
  /// Counter / station label e.g. "Cashier 1" (industrial multi-counter)
  station    String     @default("")
  /// Comma separated menu categories for KOT routing; empty = all
  categories String     @default("")
  active     Boolean    @default(true)
  jobs       PrintJob[]
  cashiers   User[]     @relation("UserBillPrinter")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model PrintJob {
  id            String         @id @default(cuid())
  type          PrintJobType
  status        PrintJobStatus @default(PENDING)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  payload       Json
  attempts      Int            @default(0)
  lastError     String?
  requestedById String?
  createdAt     DateTime       @default(now())
  printedAt     DateTime?
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  passwordHash  String
  pinHash       String?
  active        Boolean  @default(true)
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  /// Default bill printer for this cashier (industrial: each counter → own network printer)
  billPrinterId String?
  billPrinter   Printer? @relation("UserBillPrinter", fields: [billPrinterId], references: [id], onDelete: SetNull)
  orders            Order[]     @relation("OrderCashier")
  waiterOrders      Order[]     @relation("OrderWaiter")
  assignedOrders    Order[]     @relation("OrderAssignedCashier")
  itemsAdded        OrderItem[] @relation("OrderItemAddedBy")
  paymentsCollected Payment[]   @relation("PaymentCollectedBy")
  cashReceived      Payment[]   @relation("PaymentHandedTo")
  tipShares         TipShare[]
  dayCloses         DayStockClose[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model StoreCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  code      String      @unique
  sortOrder Int         @default(0)
  items     StoreItem[]
}

model StoreItem {
  id             String              @id @default(cuid())
  name           String
  categoryId     String
  category       StoreCategory       @relation(fields: [categoryId], references: [id])
  unit           UnitType
  quantityOnHand Decimal             @default(0) @db.Decimal(14, 3)
  ratePerUnit    Decimal             @default(0) @db.Decimal(14, 2)
  reorderLevel   Decimal             @default(0) @db.Decimal(14, 3)
  active         Boolean             @default(true)
  ingredients    RecipeIngredient[]
  movements      StockMovement[]
  purchaseLines  PurchaseLine[]
  dayCloseLines  DayStockCloseLine[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([categoryId, name])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  active    Boolean           @default(true)
  purchases Purchase[]
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([name])
}

model Purchase {
  id          String          @id @default(cuid())
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  /// Noon-local timestamp of the business day the goods arrived.
  purchasedAt DateTime
  payKind     PurchasePayKind
  /// Cash paid on this invoice (cash purchases = full total).
  paidAmount  Decimal         @default(0) @db.Decimal(14, 2)
  total       Decimal         @db.Decimal(14, 2)
  note        String?
  lines       PurchaseLine[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([purchasedAt])
  @@index([supplierId])
}

model PurchaseLine {
  id           String    @id @default(cuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  storeItemId  String
  storeItem    StoreItem @relation(fields: [storeItemId], references: [id])
  categoryName String
  unit         UnitType
  quantity     Decimal   @db.Decimal(14, 3)
  /// Rate on this invoice. Never rewritten when a later purchase changes the item rate.
  ratePerUnit  Decimal   @db.Decimal(14, 2)
  amount       Decimal   @db.Decimal(14, 2)
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  paidAt     DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([supplierId, paidAt])
}

model StockMovement {
  id          String        @id @default(cuid())
  storeItemId String
  storeItem   StoreItem     @relation(fields: [storeItemId], references: [id])
  type        StockMoveType @default(IN)
  quantity    Decimal       @db.Decimal(14, 3)
  ratePerUnit Decimal?      @db.Decimal(14, 2)
  note        String?
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId  String?
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  dayCloseId  String?
  dayClose    DayStockClose? @relation(fields: [dayCloseId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

/// One stock close per business day (day starts at the time set in Settings).
model DayStockClose {
  id             String              @id @default(cuid())
  businessDate   String              @unique
  stockUsedValue Decimal             @db.Decimal(14, 2)
  sales          Decimal             @default(0) @db.Decimal(14, 2)
  profit         Decimal             @default(0) @db.Decimal(14, 2)
  closedById     String?
  closedBy       User?               @relation(fields: [closedById], references: [id], onDelete: SetNull)
  lines          DayStockCloseLine[]
  movements      StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model DayStockCloseLine {
  id          String        @id @default(cuid())
  closeId     String
  close       DayStockClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem     @relation(fields: [storeItemId], references: [id])
  autoQty     Decimal       @db.Decimal(14, 3)
  extraQty    Decimal       @default(0) @db.Decimal(14, 3)
  reason      String?
  ratePerUnit Decimal       @db.Decimal(14, 2)
  amount      Decimal       @db.Decimal(14, 2)

  @@unique([closeId, storeItemId])
}

model RecipeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Recipe {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String             @default("General")
  baseUnit    UnitType           @default(KG)
  baseQty     Decimal            @default(1) @db.Decimal(14, 3)
  notes       String?
  active      Boolean            @default(true)
  ingredients RecipeIngredient[]
  menuItems   MenuItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecipeIngredient {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  unit        UnitType

  @@unique([recipeId, storeItemId])
}

model MenuItem {
  id             String         @id @default(cuid())
  name           String
  category       String?
  /// Kitchen printer station (Beverages / Cooking / BBQ).
  kitchenStation KitchenStation @default(COOKING)
  sellUnit       UnitType
  sellingPrice   Decimal        @db.Decimal(14, 2)
  recipeId       String?
  recipe         Recipe?        @relation(fields: [recipeId], references: [id])
  active         Boolean        @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

/// Seated guest who eats now and pays the whole account later. Not supplier credit.
model CreditCustomer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  cnic      String?  @unique
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String          @id @default(cuid())
  orderNo       Int             @default(autoincrement())
  /// Display label e.g. "Hall · T-1"
  tableNo       String?
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status        OrderStatus     @default(PENDING)
  paymentStatus PaymentStatus   @default(UNPAID)
  notes         String?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal         @default(0) @db.Decimal(14, 2)
  /// Guest tip — tracked separately from food sale (total).
  tipAmount     Decimal         @default(0) @db.Decimal(14, 2)
  costTotal     Decimal         @default(0) @db.Decimal(14, 2)
  cashierId     String?
  cashier       User?           @relation("OrderCashier", fields: [cashierId], references: [id])
  /// Who took / placed the order (supervisor, waiter, or cashier).
  waiterId      String?
  waiter        User?           @relation("OrderWaiter", fields: [waiterId], references: [id])
  /// Cashier selected at place-time (Main Cashier or Cashier) for billing.
  assignedCashierId String?
  assignedCashier   User?       @relation("OrderAssignedCashier", fields: [assignedCashierId], references: [id])
  /// Free-text name of who served the table (not a system user).
  servedByName  String?
  kotRounds     Int             @default(1)
  billRequestedAt DateTime?
  /// Set when the meal is on a credit account. Cash is collected later, in one settlement.
  creditCustomerId String?
  creditCustomer   CreditCustomer? @relation(fields: [creditCustomerId], references: [id])
  items         OrderItem[]
  stockMoves    StockMovement[]
  printJobs     PrintJob[]
  payments      Payment[]
  tipShares     TipShare[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([assignedCashierId])
  @@index([tableId])
  @@index([waiterId])
  @@index([creditCustomerId])
}

/// One payment taken for an order. Staff without a cash drawer (managers) hand the cash
/// to a cashier: handedTo is that cashier, who confirms when the money is received.
model Payment {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(14, 2)
  /// Tip collected with this payment (not part of order.total / amount).
  tipAmount     Decimal   @default(0) @db.Decimal(14, 2)
  collectedById String
  collectedBy   User      @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  handedToId    String?
  handedTo      User?     @relation("PaymentHandedTo", fields: [handedToId], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([handedToId, confirmedAt])
}

/// Tip allocated to a staff member for an order (split by restaurant tip policy).
model TipShare {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  /// ORDER_TAKER | SERVER | POOL
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineKind        OrderLineKind @default(MENU)
  /// Null for PER_HEAD cover-charge lines.
  menuItemId      String?
  menuItem        MenuItem?     @relation(fields: [menuItemId], references: [id])
  name            String
  sellUnit        UnitType
  quantity        Decimal       @db.Decimal(14, 3)
  ratePerUnit     Decimal       @db.Decimal(14, 2)
  amount          Decimal       @db.Decimal(14, 2)
  unitCost        Decimal       @default(0) @db.Decimal(14, 2)
  costAmount      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  kotRound        Int           @default(1)
  addedById       String?
  addedBy         User?         @relation("OrderItemAddedBy", fields: [addedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([orderId, lineKind])
}
