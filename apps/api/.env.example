# Development config. `pnpm db:start` copies this to apps/api/.env on first run.
# Installed servers do not use this file: the installer writes ProgramData\HotelSystem\hotel.env.

# API port. In development the Vite dev server (port 3000) proxies /api and /socket.io here.
PORT=4000

# Local dev database started by `pnpm db:start` (scripts/dev-db.ps1).
DATABASE_URL=postgresql://hotel:hotel_dev@localhost:5544/hotel_db?schema=public

JWT_SECRET=dev-only-change-me

# Relative paths are resolved from this file's folder.
HOTEL_DATA_DIR=../../.dev/data
PG_BIN=../../packaging/cache/pgsql/bin
# Android APK offered at /downloads (built by `pnpm apk`).
DOWNLOADS_DIR=../../releases/android

# Set to 1 to stop the UDP beacon / mDNS advertisement (e.g. on a shared office network).
DISCOVERY_DISABLED=0
