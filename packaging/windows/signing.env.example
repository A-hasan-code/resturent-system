# Copy to signing.env and fill in ONE method. Never commit signing.env or passwords.
# Rebuild: pnpm release   (or Build-Release.ps1 -RequireSign)
#
# Microsoft requirement for Smart App Control:
#   RSA Authenticode cert from a CA in the Microsoft Trusted Root Program
#   + SHA-256 digest + RFC3161 timestamp
# Preferred: Azure Trusted Signing (https://learn.microsoft.com/azure/trusted-signing/)
# Alternative: OV/EV code signing (DigiCert, Sectigo, SSL.com, GlobalSign) on hardware/HSM.

# Optional: full path to signtool.exe if not on PATH / Windows Kits
# HOTEL_SIGNTOOL=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe

# Timestamp server (RFC3161)
HOTEL_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com

# Fail the release build if signing is missing or fails
# HOTEL_SIGN_REQUIRED=1

# Re-sign binaries that already have a valid vendor signature (normally leave unset)
# HOTEL_SIGN_FORCE=1

# ---------- Method A: Azure Trusted Signing (recommended) ----------
# HOTEL_SIGN_AZURE_ACCOUNT=your-account-name
# HOTEL_SIGN_AZURE_CERT_PROFILE=your-cert-profile
# HOTEL_SIGN_AZURE_ENDPOINT=https://eus.codesigning.azure.net/
# HOTEL_SIGN_AZURE_DLIB=C:\TrustedSigning\Azure.CodeSigning.Dlib.dll
# HOTEL_SIGN_AZURE_METADATA=C:\TrustedSigning\metadata.json
# Also: az login  (or set AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET)

# ---------- Method B: PFX file (legacy / some cloud HSMs export) ----------
# HOTEL_SIGN_PFX=C:\certs\hotel-codesign.pfx
# HOTEL_SIGN_PFX_PASSWORD=your-pfx-password

# ---------- Method C: Certificate already in Windows store ----------
# HOTEL_SIGN_THUMBPRINT=0123456789ABCDEFFEDCBA9876543210ABCDEF01
# (cert must be in CurrentUser\My or LocalMachine\My with private key)

# Electron desktop signing (electron-builder). Same PFX as Method B, or leave blank to use Sign.ps1 after pack.
# CSC_LINK=C:\certs\hotel-codesign.pfx
# CSC_KEY_PASSWORD=your-pfx-password
